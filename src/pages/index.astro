---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getResumeData } from "../data/resume";
import { siteContent } from "../data/site";

const { profile, strengths, technologies, timeline, stats } = await getResumeData();
const recentTimeline = timeline.slice(0, 2);
const additionalTimeline = timeline.slice(2);
const resumeDownloadHref = import.meta.env.DEV ? "/resume-pdf" : "/Samuel-Kimama-Resume.pdf";
---

<BaseLayout title={`${profile.name} | Staff Frontend Engineer`} description={profile.summary}>
  <section class="hero u-screen-fit" id="home">
    <div>
      <p class="hero-kicker">Hi, I&apos;m</p>
      <h1>Samuel Kimama,</h1>
      <h2 class="hero-subtitle">I design scalable frontend systems that help teams ship with speed and quality.</h2>
      <p class="lead" style="margin-top: 1.5rem;">{profile.summary}</p>
      <ul class="hero-facts" aria-label="Profile highlights">
        {stats.map((item) => (
          <li>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
      <p class="meta-links" style="margin-top: 1.25rem; font-size: 0.9rem; color: var(--muted);">
        <a href={profile.contact.github} target="_blank" rel="noreferrer me">github.com/samuelmburu</a>
        <span aria-hidden="true">·</span>
        <a href={profile.contact.linkedin} target="_blank" rel="noreferrer me">linkedin.com/in/samuelkimama</a>
      </p>
      <aside class="availability-callout" aria-label="Role search">
        <p class="availability-callout__eyebrow">{siteContent.availabilityEyebrow}</p>
        <p class="availability-callout__text">{siteContent.availability}</p>
      </aside>
    </div>
  </section>

  <section class="section" id="about">
    <div class="section-heading">
      <div>
        <span class="eyebrow">About</span>
        <h2>Architecture, leverage, and complex product work.</h2>
      </div>
    </div>
    <div class="resume-grid" style="margin-top: 1rem;">
      <article class="panel">
        {siteContent.about.map((paragraph) => (
          <p style="margin-top: 1rem;">{paragraph}</p>
        ))}
      </article>
      <article class="panel">
        <h3>Core strengths</h3>
        <ul class="list">
          {strengths.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  {
    false && (
      <section class="section">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Expertise</span>
            <h2>What I focus on.</h2>
          </div>
        </div>
        <div class="section-grid">
          {siteContent.expertise.map((item) => (
            <article class="panel">
              <h3>{item.title}</h3>
              <p style="margin-top: 0.75rem;">{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <section class="section" id="resume">
    <div class="section-heading">
      <div>
        <span class="eyebrow" style="margin-bottom: 0;">Resume</span>
        <h2>Experience and supporting detail.</h2>
      </div>
      <!-- <p>{siteContent.availability}</p> -->
    </div>
    <div class="actions" style="margin-top: 0; margin-bottom: 1rem;">
      <a
        class="button button--secondary resume-action"
        href={resumeDownloadHref}
        download={import.meta.env.DEV ? undefined : true}
        target={import.meta.env.DEV ? "_blank" : undefined}
        rel={import.meta.env.DEV ? "noreferrer" : undefined}
      >
        <Icon name="lucide:download" size="1rem" aria-hidden="true" />
        Download resume
      </a>
      <a
        class="button button--secondary resume-action"
        href={profile.contact.linkedin}
        target="_blank"
        rel="noreferrer"
      >
        View LinkedIn profile
      </a>
    </div>
    <div class="timeline" style="grid-template-columns: 1fr; gap: 1rem;">
      {
        recentTimeline.map((entry) => (
          <article class="timeline-item">
            <div class="timeline-meta">
              <span>{entry.period}</span>
              {/* <span>{entry.scope}</span> */}
            </div>
            <h3>{entry.role}</h3>
            <p style="margin-top: 0.35rem;">{entry.company}{entry.location && <span class="role-location"> · {entry.location}</span>}</p>
            <p style="margin-top: 0.85rem;">{entry.summary}</p>
            <ul class="list">
              {entry.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p style="margin-top: 1rem;">
              <strong>Impact:</strong> {entry.impact}
            </p>
            {entry.patents && entry.patents.length > 0 && (
              <div class="patent-row" style="margin-top: 1rem;">
                <span class="patent-row__label" aria-hidden="true">Patent</span>
                <ul class="patent-row__list" aria-label="Patents">
                  {entry.patents.map((patent) => (
                    <li class="patent-row__item">
                      <p class="patent-entry">
                        <a
                          href={patent.href}
                          target="_blank"
                          rel="noreferrer"
                          class="patent-title-link"
                          title={patent.full_title}
                        >{patent.title}</a>{` — ${patent.description}`}
                      </p>
                      <p class="patent-meta">{patent.number} · Issued {patent.issued} · {patent.assignee}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))
      }
    </div>
    {
      additionalTimeline.length > 0 && (
        <details class="resume-details">
          <summary class="resume-action">
            <span class="resume-details__more">See more experience</span>
            <span class="resume-details__less">Show less experience</span>
          </summary>
          <div class="timeline" style="grid-template-columns: 1fr; gap: 1rem; margin-top: 1rem;">
            {
              additionalTimeline.map((entry) => (
                <article class="timeline-item">
                  <div class="timeline-meta">
                    <span>{entry.period}</span>
                    {/* <span>{entry.scope}</span> */}
                  </div>
                  <h3>{entry.role}</h3>
                  <p style="margin-top: 0.35rem;">{entry.company}{entry.location && <span class="role-location"> · {entry.location}</span>}</p>
                  <p style="margin-top: 0.85rem;">{entry.summary}</p>
                  <ul class="list">
                    {entry.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <p style="margin-top: 1rem;">
                    <strong>Impact:</strong> {entry.impact}
                  </p>
                </article>
              ))
            }
          </div>
        </details>
      )
    }
    <div class="section">
      <article class="resume-block">
        <h3>Technologies</h3>
        <ul class="list technologies-list">
          {technologies.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  {
    (
      <section class="section" id="projects">
        <div class="section-heading">
          <div>
            <span class="eyebrow" style="margin-bottom: 0;">Projects</span>
            <h2>Personal projects and active explorations.</h2>
          </div>
        </div>
        <div class="project-grid">
          {siteContent.projects.map((project) => {
            const isExternal = project.href?.startsWith("http");
            return project.href ? (
              <a
                href={project.href}
                class="project-card"
                {...(isExternal ? { target: "_blank", rel: "noreferrer" } : {})}
              >
                <div class="project-meta">
                  <span>{project.category}</span>
                  <span>{project.year}</span>
                </div>
                <h3>
                  {project.name}
                  {isExternal && <Icon name="lucide:external-link" size="0.9em" aria-hidden="true" style="margin-left: 0.35em; vertical-align: middle; opacity: 0.5;" />}
                </h3>
                <p style="margin-top: 0.75rem;">{project.description}</p>
              </a>
            ) : (
              <article class="project-card">
                <div class="project-meta">
                  <span>{project.category}</span>
                  <span>{project.year}</span>
                </div>
                <h3>{project.name}</h3>
                <p style="margin-top: 0.75rem;">{project.description}</p>
              </article>
            );
          })}
        </div>
      </section>
    )
  }


  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-heading">Common questions about Samuel Kimama</h2>
      </div>
    </div>
    <div class="resume-grid" style="margin-top: 1rem;">
      <article class="panel">
        <h3>What does a Staff Frontend Engineer do?</h3>
        <p style="margin-top: 0.75rem;">
          A Staff Frontend Engineer is defined as a senior individual contributor who operates at the intersection of architecture, product, and engineering leadership. Samuel Kimama refers to this scope as the work of building <em>leverage</em> — strong frontend systems, clear component models, and patterns that let teams ship complex products with speed and quality, without accumulating drag.
        </p>
      </article>
      <article class="panel">
        <h3>Is Samuel Kimama available for new roles?</h3>
        <p style="margin-top: 0.75rem;">
          Yes. Samuel Kimama (GitHub: <a href={profile.contact.github} target="_blank" rel="noreferrer">samuelmburu</a>) is targeting remote Staff-level frontend engineering roles with broad product and platform ownership. He is open to roles where frontend architecture, cross-functional leadership, and engineering standards are first-class concerns.
        </p>
      </article>
      <article class="panel">
        <h3>What companies has Samuel Kimama worked at?</h3>
        <p style="margin-top: 0.75rem;">
          Samuel Kimama has held senior and staff-level frontend roles at <a href="https://linkedin.com/in/samuelkimama" target="_blank" rel="noreferrer">LinkedIn</a> (2012–2014), Survata (2015–2020), Southwest Airlines (2022–2023), and WITNESS AI (2023–2026). He has also worked at HP, Starbucks, Eddie Bauer, and Resource Interactive earlier in his career.
        </p>
      </article>
      <article class="panel">
        <h3>What is Samuel Kimama's most notable technical contribution?</h3>
        <p style="margin-top: 0.75rem;">
          Samuel Kimama is a named inventor on <a href="https://patents.google.com/patent/US12587529B2/en" target="_blank" rel="noreferrer">US Patent 12,587,529 B2</a> — <em>Methods and systems for security enhancement in artificial intelligence model interactions via automated injection and proxy server implementation</em> — issued March 2026 by the United States Patent and Trademark Office, assigned to WitnessAI.
        </p>
      </article>
    </div>
  </section>

</BaseLayout>

---
import { Icon } from "astro-icon/components";
import { getResumeData } from "../data/resume";

const { profile, strengths, technologies, education, timeline } = await getResumeData();

const formatContactUrl = (value: string) => value.replace(/^https?:\/\//, "");

type ContactItem = { icon: string; href: string; label: string };
const contactItems: ContactItem[] = [
  profile.contact.email && {
    icon: "lucide:mail",
    href: `mailto:${profile.contact.email}`,
    label: profile.contact.email,
  },
  profile.contact.linkedin && {
    icon: "mdi:linkedin",
    href: profile.contact.linkedin,
    label: formatContactUrl(profile.contact.linkedin),
  },
  profile.contact.github && {
    icon: "mdi:github",
    href: profile.contact.github,
    label: formatContactUrl(profile.contact.github),
  },
  profile.contact.website && {
    icon: "lucide:globe",
    href: profile.contact.website,
    label: formatContactUrl(profile.contact.website),
  },
  profile.contact.book_me && {
    icon: "mdi:calendar",
    href: profile.contact.book_me,
    label: `Grab time on my calendar: ${formatContactUrl(profile.contact.book_me)}`,
  },
].filter(Boolean) as ContactItem[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} Resume</title>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <style>
      :root {
        --page-width: 8.5in;
        --page-height: 11in;
        --page-margin: 0.5in;
        --text: #111111;
        --muted: #4f4f4f;
        --line: #d6d6d6;
        --accent: #2563eb;
      }

      @page {
        size: 8.5in 11in;
        margin: 0;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        color: var(--text);
        background: #ffffff;
        font-family: "Manrope", "Avenir Next", "Segoe UI", sans-serif;
        font-optical-sizing: auto;
      }

      body {
        min-height: 100vh;
      }

      main {
        width: var(--page-width);
        padding: var(--page-margin);
        display: block;
        background: #ffffff;
      }

      main > * + * {
        margin-top: 0.05in;
      }

      @media screen {
        html,
        body {
          background:
            radial-gradient(circle at top left, rgba(37, 99, 235, 0.06), transparent 28%),
            linear-gradient(180deg, #f4f1ea 0%, #ebe6dc 100%);
        }

        body {
          display: flex;
          justify-content: center;
          padding: 2rem 1rem 3rem;
        }

        main {
          min-height: var(--page-height);
          box-shadow:
            0 24px 60px rgba(22, 22, 22, 0.14),
            0 8px 22px rgba(22, 22, 22, 0.08);
          border: 1px solid rgba(17, 17, 17, 0.08);
        }
      }

      @media print {
        html,
        body {
          background: #ffffff;
        }

        body {
          display: block;
          padding: 0;
        }

        main {
          box-shadow: none;
          border: 0;
        }
      }

      .header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.3in;
        align-items: start;
      }

      .name {
        margin: 0;
        font-size: 28px;
        line-height: 1;
        letter-spacing: -0.04em;
        font-family: "Fraunces", "Iowan Old Style", "Palatino Linotype", serif;
      }

      .headline {
        margin: 0.08in 0 0;
        font-size: 12.5px;
        color: var(--muted);
      }

      .contact {
        display: grid;
        grid-template-columns: auto auto;
        column-gap: 0.18in;
        row-gap: 0.04in;
        justify-content: end;
        font-size: 11px;
        line-height: 1.4;
      }

      .contact-item {
        display: inline-flex;
        align-items: center;
        gap: 0.05in;
        color: inherit;
        text-decoration: none;
      }

      .contact-icon {
        width: 11px;
        height: 11px;
        color: var(--muted);
        flex-shrink: 0;
      }

      .summary {
        margin-top: 0.01in;
        font-size: 11.1px;
        line-height: 1.42;
      }

      .resume-layout {
        display: block;
      }

      .section + .section {
        margin-top: 0.1in;
      }

      .section-title {
        margin: 0 0 0.045in;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
        break-after: avoid;
      }

      .strengths {
        margin: 0;
        padding-left: 0.16in;
        column-count: 1;
        column-gap: 0.24in;
        font-size: 10.2px;
        line-height: 1.34;
      }

      .strengths li {
        break-inside: avoid;
        margin-bottom: 0.04in;
      }

      .role + .role {
        margin-top: 0.09in;
        padding-top: 0;
        border-top: 0;
      }

      .role-header {
        display: flex;
        justify-content: space-between;
        gap: 0.12in;
        align-items: baseline;
        break-after: avoid;
        break-inside: avoid;
      }

      .role-title {
        margin: 0;
        font-size: 11px;
        font-weight: 700;
      }

      .role-company {
        color: var(--muted);
        font-weight: 600;
      }

      .role-location {
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .role-period {
        flex-shrink: 0;
        color: var(--muted);
        font-size: 9.6px;
      }

      .role-summary {
        margin: 0.03in 0 0;
        font-size: 10px;
        line-height: 1.34;
      }

      .role-scope {
        margin: 0.02in 0 0;
        font-size: 9.5px;
        color: var(--muted);
      }

      .role-highlights {
        margin: 0.045in 0 0;
        padding-left: 0.18in;
        font-size: 9.6px;
        line-height: 1.28;
      }

      .role-highlights li + li {
        margin-top: 0.015in;
      }

      .role-impact {
        margin: 0.045in 0 0;
        font-size: 9.6px;
        line-height: 1.28;
      }

      .skills-copy {
        font-size: 9.8px;
        line-height: 1.35;
        color: var(--muted);
      }

      .role-patent {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-areas:
          "label header"
          ".     desc";
        column-gap: 0.06in;
        row-gap: 0.02in;
        margin: 0.045in 0 0;
        break-inside: avoid;
      }

      .role-patent + .role-patent {
        margin-top: 0.06in;
        padding-top: 0.06in;
        border-top: 0.5px solid var(--line);
      }

      .role-patent__label {
        grid-area: label;
        align-self: baseline;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .role-patent__header {
        grid-area: header;
        display: flex;
        justify-content: space-between;
        gap: 0.12in;
        align-items: baseline;
      }

      .role-patent__title {
        font-size: 10px;
        font-weight: 700;
        color: var(--text);
        text-decoration: none;
      }

      .role-patent__number {
        flex-shrink: 0;
        font-size: 9px;
        color: var(--muted);
      }

      .role-patent__desc {
        grid-area: desc;
        margin: 0;
        font-size: 9.6px;
        line-height: 1;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <main>
      <header class="header">
        <div>
          <h1 class="name">{profile.name}</h1>
          <p class="headline">
            {profile.headline} { profile.location && `• ${profile.location}` }
          </p>
        </div>
        <div class="contact">
          {contactItems.map((item) => (
            <a class="contact-item" data-for={item.label.toLowerCase()} href={item.href}>
              <Icon name={item.icon} class="contact-icon" aria-hidden="true" data-for={item.label.toLowerCase()} />
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </header>

      <p class="summary">{profile.summary}</p>

      <div class="resume-layout">
        <section class="section">
          <h2 class="section-title">Experience</h2>
          {
            timeline.map((entry) => (
              <article class="role">
                <div class="role-header">
                  <h3 class="role-title">
                    {entry.role}{" "}
                    <span class="role-company">• {entry.company}</span>
                    {entry.location && <span class="role-location"> · {entry.location}</span>}
                  </h3>
                  <span class="role-period">{entry.period}</span>
                </div>
                {/* {entry.scope && <p class="role-scope">{entry.scope}</p>} */}
                <p class="role-summary">{entry.summary}</p>
                <ul class="role-highlights">
                  {entry.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="role-impact">
                  <strong>Impact:</strong> {entry.impact}
                </p>
                {entry.patents && entry.patents.length > 0 && entry.patents.map((patent) => (
                  <div class="role-patent">
                    <span class="role-patent__label">Patent</span>
                    <div class="role-patent__header">
                      <a href={patent.href} class="role-patent__title" title={patent.full_title}>{patent.title}</a>
                      <span class="role-patent__number">{patent.number} · {patent.issued}</span>
                    </div>
                    <p class="role-patent__desc">{patent.description}</p>
                  </div>
                ))}
              </article>
            ))
          }
        </section>

        <section class="section">
          <h2 class="section-title">Core Strengths</h2>
          <ul class="strengths">
            {strengths.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="section">
          <h2 class="section-title">Technologies</h2>
          <ul class="strengths">
            {technologies.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="section">
          <h2 class="section-title">Education</h2>
          <div class="skills-copy">{education.degree}</div>
          <div class="skills-copy">{education.school}</div>
          {education.period && <div class="role-period">{education.period}</div>}
        </section>
      </div>
    </main>
  </body>
</html>
